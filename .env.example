# Who reads page images: gemini (default, cloud: pages are sent to Google), historic (local), qari (local), claude, mock
# OCR_ENGINE=gemini
# Google AI Studio key. Without billing = free tier: Google uses the content to improve its products
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite  # default, free tier; other free: gemma-4-26b-a4b-it, gemma-4-31b-it, gemini-flash-latest, gemini-2.5-pro (gemini-2.5-flash-lite is closed to new users); gemini-3.1-pro-preview and gemini-4-argon are paid only
# GEMINI_FREE_TIER=1              # set 0 once billing is enabled so real prices count against the budget
# GEMINI_THINKING=medium         # low | medium | high
# GEMINI_BUDGET_USD=2.0          # hard cap on total Gemini spend, separate from the Claude cap
# Line segmentation: kraken (default; follows tilted and curved lines, needs `make kraken`) or classic
# SEGMENTER=kraken
# KRAKEN_PYTHON=.venv-kraken/bin/python
# Confidence ceiling for the local OCR models (keeps them below the auto-approve bar)
# OCR_CONFIDENCE_CAP=0.9

# Required for real Claude agents. Without it the app runs in offline mock mode.
ANTHROPIC_API_KEY=

# Optional: force mock mode on (1) or off (0).
# MOCK_LLM=0

# Optional model overrides (defaults in backend/app/config.py)
# MODEL_INTAKE=claude-haiku-5-5
# MODEL_DIGITIZATION=claude-opus-5-5
# MODEL_CLAUSE=claude-sonnet-5-5
# MODEL_POLICY=claude-sonnet-5-5
# MODEL_REDLINE=claude-sonnet-5-5
# MODEL_DECISION=claude-haiku-5-5

# Spend controls (defaults suit a small credit)
# ECONOMY_MODE=1            # templates for redlines and summary, Haiku for grouping and clause typing
# REDLINE_SOURCE=template   # or claude
# SUMMARY_SOURCE=template   # or claude
# CLAUDE_BUDGET_USD=4.5     # hard cap on total spend; past it all agents use rule-based fallbacks
# REVIEW_MIN_OCR_MEAN=0.4   # below this OCR confidence the legal review is skipped

# Super-resolution of small page photos before OCR (Real-ESRGAN)
# ENHANCE_IMAGES=1
# ENHANCE_MODEL=x4plus          # or general-x4v3 (faster, softer)
# ENHANCE_MIN_SIDE=1600         # only pages smaller than this are enhanced
# ENHANCE_TARGET_SIDE=2400      # the 4x result is sized down to at most this

# Embeddings of reviewed contracts for search and export (local model)
# EMBEDDINGS_ENABLED=1
# EMBED_MODEL=intfloat/multilingual-e5-base
