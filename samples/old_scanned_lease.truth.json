     "kind": "clause",
     "number_raw": "أولاً",
     "heading": null,
     "text": "أجر الطرف الأول للطرف الثاني المحل التجاري الكائن بحي البلد بمدينة جدة لاستعماله في بيع الأقمشة.",
     "continues_from_previous_page": false,
