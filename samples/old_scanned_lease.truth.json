    {
     "id": "p1_b5",
     "kind": "clause",
     "number_raw": "ثالثاً",
     "heading": null,
     "text": "الأجرة السنوية ثلاثون ألف ريال تدفع على قسطين متساويين، الأول عند توقيع العقد والثاني بعد ستة أشهر.",
     "continues_from_previous_page": false,
     "continues_to_next_page": false,
     "confidence": 0.858,
     "bbox": [
