     "kind": "clause",
     "number_raw": "ثانياً",
     "heading": null,
     "text": "مدة الإيجار سنة هجرية واحدة تبدأ من ٠١/١٠/١٤٢٨هـ وتنتهي في ٣٠/٠٩/١٤٢٩هـ.",
     "continues_from_previous_page": false,
