     ]
    },
    {
     "id": "p1_b6",
     "kind": "clause",
     "number_raw": "رابعاً",
     "heading": null,
     "text": "لا يحق للمستأجر تأجير المحل من الباطن أو التنازل عنه للغير إلا بموافقة المؤجر الخطية.",
     "continues_from_previous_page": false,
     "continues_to_next_page": false,
     "confidence": 0.864,
     "bbox": [
